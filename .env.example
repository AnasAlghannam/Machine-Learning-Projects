# Copy this file to `.env` and fill in your keys. `.env` is git-ignored and never committed.
# The agent notebooks load these automatically via python-dotenv (find_dotenv(usecwd=True)),
# so a single .env at the repo root works for every project.

# Groq (LLM) — required by all the LLM/agent notebooks.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Serper (web search) — required by the crewAI notebooks that search the web
# (AutomateEventPlanning, TailorJobApplicationsCrew, MultiAgentFinancialAnalysis, CustomerOutreachTools).
# Also used by ReflexionAgentExternalKnowledge when no Tavily key is set.
# Get a key at https://serper.dev
SERPER_API_KEY=

# Tavily (agent-oriented web search) — optional. ReflexionAgentExternalKnowledge prefers this
# over Serper when it is set. Get a key at https://app.tavily.com/sign-in
TAVILY_API_KEY=

# OpenWeather — required by WeatherAgentFromScratch.
# Get a free key at https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
